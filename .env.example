# Default: local mock responses, no API key or paid calls.
# To enable OpenAI, add the server key below and set this to false.
# Restart dev/server processes and rebuild production assets after changing it.
VITE_USE_MOCK_AI=true

# Server-only. Never use a VITE_ prefix for secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-2
