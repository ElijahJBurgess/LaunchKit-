# Frontend: true = use built-in mock AI (no key, no network calls, no cost).
# Set to false once you're ready to connect the real Anthropic API.
VITE_USE_MOCK_AI=true

# Backend (only needed once VITE_USE_MOCK_AI=false):
ANTHROPIC_API_KEY=sk-ant-...
# Optional, defaults to claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5
